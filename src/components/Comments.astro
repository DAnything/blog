---
import "@/styles/artalk.css";
import { commentConfig } from "@/config";
---
{commentConfig.enable && (
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <div id="artalk"></div>
        </div>
    </div>
)}

<script>
import { commentConfig } from "@/config";

const { artalk: artalkConfig } = commentConfig;

type ArtalkInstance = {
	destroy: () => void;
	setDarkMode: (dark: boolean) => void;
};

declare global {
	interface Window {
		Artalk?: {
			init: (conf: Record<string, unknown>) => ArtalkInstance;
		};
	}
}

let instance: ArtalkInstance | null = null;

// テーマ切替は html 要素の dark クラスの付け外しで行われる
function isDark(): boolean {
	return document.documentElement.classList.contains("dark");
}

function mount() {
	const container = document.getElementById("artalk");
	if (!container) return;

	// 黙って失敗すると空のカードだけが残って原因が追えないため、
	// 読み込み漏れと初期化エラーはコンソールに出す
	if (!window.Artalk) {
		console.error(
			`[comments] Artalk を読み込めませんでした (${artalkConfig.server}/dist/Artalk.js)`,
		);
		return;
	}

	try {
		// 2 回目以降 (swup 遷移) は既存インスタンスを捨てて作り直す
		instance?.destroy();
		instance = window.Artalk.init({
			el: container,
			server: artalkConfig.server,
			site: artalkConfig.site,
			locale: artalkConfig.locale,
			darkMode: isDark(),
			// クエリ文字列でスレッドが分かれないよう URL を明示する
			pageKey: location.origin + location.pathname,
			pageTitle: document.title,
		});
	} catch (e) {
		instance = null;
		console.error("[comments] Artalk の初期化に失敗しました", e);
	}
}

// 初回だけローダーを注入する。読み込み後に window.Artalk が生える。
function load() {
	if (window.Artalk) {
		mount();
		return;
	}

	const css = document.createElement("link");
	css.rel = "stylesheet";
	css.href = `${artalkConfig.server}/dist/Artalk.css`;
	document.head.appendChild(css);

	const script = document.createElement("script");
	script.src = `${artalkConfig.server}/dist/Artalk.js`;
	script.onload = mount;
	document.head.appendChild(script);
}

function syncTheme() {
	instance?.setDarkMode(isDark());
}

if (commentConfig.enable) {
	new MutationObserver(syncTheme).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ["class"],
	});

	const setup = () => {
		window.swup.hooks.on("page:view", load);
	};

	load();

	if (window?.swup?.hooks) {
		setup();
	} else {
		document.addEventListener("swup:enable", setup);
	}
}
</script>
